{
  "name": "unbzip2-stream",
  "version": "1.4.2",
  "description": "streaming unbzip2 implementation in pure javascript for node and browsers",
  "keywords": [
    "bzip",
    "bzip2",
    "bz2",
    "stream",
    "streaming",
    "decompress",
    "through"
  ],
  "scripts": {
    "browser-test": "node --test tests/browser/*.test.js",
    "prepare-long-test": "head -c 104857600 < /dev/urandom | tee tests/fixtures/vmlinux.bin | bzip2 > tests/fixtures/vmlinux.bin.bz2",
    "long-test": "node --test tests/extra/long.test.js",
    "test": "node --test tests/*.test.js"
  },
  "type": "module",
  "license": "MIT",
  "author": "Jan Bölsche <jan@lagomorph.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regular/unbzip2-stream.git"
  },
  "bugs": {
    "url": "https://github.com/regular/unbzip2-stream/issues"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "stream-equal": "2.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "11.17.0",
      "onFail": "download"
    }
  }
}
